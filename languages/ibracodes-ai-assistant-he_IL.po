msgstr ""
"Project-Id-Version: IbraCodes AI Assistant\n"
"Language: he_IL\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "IbraCodes AI Assistant"
msgstr "IbraCodes AI Assistant"

msgid "https://ibracodes.com"
msgstr "https://ibracodes.com"

msgid "An AI assistant for any WordPress site. It answers from your pages and posts and the facts you write, captures leads, and on WooCommerce stores recommends products the customer can add to cart. Uses your own OpenAI key."
msgstr "עוזר AI לכל אתר וורדפרס. עונה מתוך העמודים והפוסטים שלכם ומתוך עובדות שאתם כותבים, אוסף לידים, ובחנויות ווקומרס ממליץ על מוצרים שהלקוח יכול להוסיף לסל. עובד עם מפתח OpenAI שלכם."

msgid "Ibracodes"
msgstr "Ibracodes"

msgid "Another copy of IbraCodes AI Assistant is already active. Deactivate one of them."
msgstr "עותק נוסף של IbraCodes AI Assistant כבר פעיל. כבו אחד מהם."

msgid "IbraCodes AI Assistant requires PHP 8.1 or later."
msgstr "IbraCodes AI Assistant דורש PHP 8.1 ומעלה."

msgid "Plugin activation error"
msgstr "שגיאה בהפעלת התוסף"

msgid "AI Assistant"
msgstr "עוזר AI"

msgid "Settings"
msgstr "הגדרות"

msgid "Testing…"
msgstr "בודק…"

msgid "Rebuilding…"
msgstr "בונה מחדש…"

msgid "Request failed."
msgstr "הבקשה נכשלה."

msgid "No one is waiting."
msgstr "אף אחד לא ממתין."

msgid "(no question recorded)"
msgstr "(לא נרשמה שאלה)"

msgid "Waiting under a minute"
msgstr "ממתין פחות מדקה"

msgid "Waiting %s min"
msgstr "ממתין %s דק׳"

msgid "Waiting %s h"
msgstr "ממתין %s שע׳"

msgid "Waiting %s d"
msgstr "ממתין %s ימים"

msgid "%s unread"
msgstr "%s שלא נקראו"

msgid "Session expired. Reload the page."
msgstr "פג תוקף ההתחברות. טענו את העמוד מחדש."

msgid "That conversation no longer exists."
msgstr "השיחה הזו כבר לא קיימת."

msgid "Claim"
msgstr "הצטרפות לשיחה"

msgid "Close chat"
msgstr "סגירת הצ׳אט"

msgid "Send"
msgstr "שליחה"

msgid "Write a reply"
msgstr "כתבו תשובה"

msgid "Claim the chat to reply"
msgstr "הצטרפו לשיחה כדי לענות"

msgid "Replying takes over from %s"
msgstr "תשובה תעביר את השיחה מ-%s אליכם"

msgid "Visitor"
msgstr "מבקר"

msgid "Assistant"
msgstr "העוזר"

msgid "Loading…"
msgstr "טוען…"

msgid "Waiting"
msgstr "בהמתנה"

msgid "Live"
msgstr "לייב"

msgid "Missed"
msgstr "לא נענתה"

msgid "Closed"
msgstr "נסגרה"

msgid "AI"
msgstr "AI"

msgid "You are not allowed to do that."
msgstr "אין לכם הרשאה לפעולה הזו."

msgid "Live on the storefront"
msgstr "פעיל באתר"

msgid "Not live"
msgstr "לא פעיל"

msgid "Overview"
msgstr "סקירה"

msgid "Appearance"
msgstr "מראה"

msgid "Agent"
msgstr "הסוכן"

msgid "Setup"
msgstr "הגדרה"

msgid "Catalogue"
msgstr "קטלוג"

msgid "Conversations"
msgstr "שיחות"

msgid "Live chats"
msgstr "צ׳אטים חיים"

msgid "Leads"
msgstr "לידים"

msgid "Settings saved."
msgstr "ההגדרות נשמרו."

msgid "Lead deleted, along with its conversation."
msgstr "הליד נמחק, יחד עם השיחה שלו."

msgid "The agent is off because no API key is connected. Customers see nothing until you add one."
msgstr "הסוכן כבוי כי לא חובר מפתח API. הלקוחות לא רואים כלום עד שתוסיפו מפתח."

msgid "The agent is switched off. Customers see nothing until you turn it on."
msgstr "הסוכן כבוי. הלקוחות לא רואים כלום עד שתדליקו אותו."

msgid "Connect now"
msgstr "חברו עכשיו"

msgid "The last request to OpenAI failed with HTTP %1$d. %2$s (%3$s)"
msgstr "הבקשה האחרונה ל-OpenAI נכשלה עם שגיאה %1$d. %2$s (%3$s)"

msgid "Save settings"
msgstr "שמירת הגדרות"

msgid "last 30 days"
msgstr "ב-30 הימים האחרונים"

msgid "Replies sent"
msgstr "תשובות שנשלחו"

msgid "Products shown"
msgstr "מוצרים שהוצגו"

msgid "recommendations made"
msgstr "המלצות שניתנו"

msgid "Added to cart"
msgstr "נוסף לסל"

msgid "chats that led to a cart"
msgstr "שיחות שהובילו לסל"

msgid "Leads, 30 days"
msgstr "לידים, 30 יום"

msgid "visitors who left their details"
msgstr "מבקרים שהשאירו פרטים"

msgid "Questions the agent could not answer"
msgstr "שאלות שהסוכן לא ידע לענות עליהן"

msgid "The catalogue search came back empty. Each one is a product you do not stock, or a word your product titles never use."
msgstr "החיפוש בקטלוג חזר ריק. כל שורה כאן היא מוצר שאין לכם, או מילה שלא מופיעה בשמות המוצרים שלכם."

msgid "Nothing yet. Unanswered questions show up here as customers ask them."
msgstr "עדיין אין. שאלות ללא מענה יופיעו כאן כשלקוחות ישאלו אותן."

msgid "Monthly usage"
msgstr "שימוש חודשי"

msgid "of %s API calls"
msgstr "מתוך %s קריאות API"

msgid "%1$s today of %2$s. At this pace the month ends near %3$s calls."
msgstr "%1$s היום מתוך %2$s. בקצב הזה החודש ייגמר סביב %3$s קריאות."

msgid "Top products shown"
msgstr "המוצרים שהוצגו הכי הרבה"

msgid "No recommendations yet."
msgstr "עדיין אין המלצות."

msgid "%s ago"
msgstr "לפני %s"

msgid "Launcher"
msgstr "כפתור הצ׳אט"

msgid "How the closed widget appears on the storefront."
msgstr "איך נראה הצ׳אט הסגור באתר."

msgid "Corner"
msgstr "פינה"

msgid "Bottom right"
msgstr "ימין למטה"

msgid "Bottom left"
msgstr "שמאל למטה"

msgid "side of the screen"
msgstr "צד המסך"

msgid "Show a label next to the icon"
msgstr "הצגת טקסט ליד האייקון"

msgid "A labelled pill gets noticed more than a bare bubble. It collapses to a circle on phones either way."
msgstr "כפתור עם טקסט מושך יותר תשומת לב מבועה ריקה. בנייד הוא מתכווץ לעיגול בכל מקרה."

msgid "Label"
msgstr "טקסט"

msgid "Accent colour"
msgstr "צבע ראשי"

msgid "Used for the launcher, the customer's own messages and the add-to-cart button."
msgstr "משמש לכפתור הצ׳אט, להודעות הלקוח ולכפתור ההוספה לסל."

msgid "Copy"
msgstr "טקסטים"

msgid "Write these in your store's language. The agent replies in it automatically."
msgstr "כתבו אותם בשפת החנות. הסוכן עונה בה אוטומטית."

msgid "Header title"
msgstr "כותרת"

msgid "Header subtitle"
msgstr "כותרת משנה"

msgid "Opening message"
msgstr "הודעת פתיחה"

msgid "Opening chips"
msgstr "שאלות מוצעות"

msgid "One per line, up to four. Shown as buttons under the opening message."
msgstr "אחת בכל שורה, עד ארבע. מוצגות ככפתורים מתחת להודעת הפתיחה."

msgid "Show \"Developed by Ibracodes\" under the chat"
msgstr "הצגת \"פותח על ידי Ibracodes\" מתחת לצ׳אט"

msgid "A small credit line linking to ibracodes.com. Off by default."
msgstr "שורת קרדיט קטנה עם קישור ל-ibracodes.com. כבויה כברירת מחדל."

msgid "Changes go live on the storefront as soon as you save."
msgstr "השינויים עולים לאתר ברגע השמירה."

msgid "Connection"
msgstr "חיבור"

msgid "The store uses its own OpenAI account and pays OpenAI directly for what the chat uses."
msgstr "החנות משתמשת בחשבון OpenAI שלה ומשלמת ל-OpenAI ישירות על השימוש בצ׳אט."

msgid "Show the chat to customers"
msgstr "הצגת הצ׳אט ללקוחות"

msgid "It only appears once a working key is saved."
msgstr "מופיע רק אחרי שנשמר מפתח תקין."

msgid "OpenAI API key"
msgstr "מפתח API של OpenAI"

msgid "Set in wp-config.php"
msgstr "מוגדר ב-wp-config.php"

msgid "WSA_OPENAI_KEY is defined, so the constant wins and this field is hidden."
msgstr "הקבוע WSA_OPENAI_KEY מוגדר, ולכן הוא גובר והשדה הזה מוסתר."

msgid "Stored in this site's database, so any administrator can read it. Where that matters, define WSA_OPENAI_KEY in wp-config.php instead."
msgstr "נשמר במסד הנתונים של האתר, כך שכל מנהל יכול לקרוא אותו. אם זה משנה לכם, הגדירו במקום זאת WSA_OPENAI_KEY ב-wp-config.php."

msgid "Test connection"
msgstr "בדיקת חיבור"

msgid "Model"
msgstr "מודל"

msgid "Shop questions rarely need the expensive model. Start cheap and move up only if answers disappoint."
msgstr "שאלות של לקוחות כמעט אף פעם לא צריכות את המודל היקר. התחילו בזול ועלו רק אם התשובות מאכזבות."

msgid "House rules"
msgstr "כללי הבית"

msgid "Plain sentences work better than a wall of instructions. Sent with every conversation."
msgstr "משפטים פשוטים עובדים טוב יותר מקיר של הוראות. נשלחים בכל שיחה."

msgid "Store facts"
msgstr "עובדות על החנות"

msgid "Free shipping over 50. Returns within 14 days. One year warranty."
msgstr "משלוח חינם מעל 399 ש\"ח. החזרות תוך 14 יום. אחריות שנה."

msgid "The only non-product information the agent may state as fact. Anything not written here, it will say it does not know."
msgstr "המידע היחיד שאינו על מוצרים שהסוכן רשאי למסור כעובדה. כל מה שלא כתוב כאן, הוא יגיד שאינו יודע."

msgid "Content"
msgstr "תוכן"

msgid "The pages and posts the assistant may read and answer from. Drafts, private and password-protected content are never included."
msgstr "העמודים והפוסטים שהעוזר רשאי לקרוא ולענות מתוכם. טיוטות, תוכן פרטי ותוכן מוגן בסיסמה לעולם לא נכללים."

msgid "Content types"
msgstr "סוגי תוכן"

msgid "Which pages"
msgstr "אילו עמודים"

msgid "All published pages and posts"
msgstr "כל העמודים והפוסטים שפורסמו"

msgid "Only the pages listed below"
msgstr "רק העמודים שברשימה למטה"

msgid "Pages"
msgstr "עמודים"

msgid "Page ids, comma separated. The id is in the address bar when you edit a page."
msgstr "מזהי עמודים, מופרדים בפסיקים. המזהה מופיע בשורת הכתובת כשעורכים עמוד."

msgid "How the assistant finds content"
msgstr "איך העוזר מוצא תוכן"

msgid "WordPress search (free)"
msgstr "חיפוש וורדפרס (חינם)"

msgid "Embeddings index (better answers)"
msgstr "אינדקס embeddings (תשובות טובות יותר)"

msgid "Building the index costs about one cent per hundred pages once, then a fraction of that per question. It uses your OpenAI key and counts against your daily and monthly limits."
msgstr "בניית האינדקס עולה בערך סנט אחד לכל מאה עמודים, פעם אחת, ואחר כך שבריר מזה לכל שאלה. היא משתמשת במפתח OpenAI שלכם ונספרת במגבלות היומיות והחודשיות."

msgid "Indexed %1$s of %2$s pages, %3$s waiting."
msgstr "באינדקס %1$s מתוך %2$s עמודים, %3$s ממתינים."

msgid "Rebuild index"
msgstr "בנייה מחדש של האינדקס"

msgid "Offer to take the visitor's details"
msgstr "הצעה לקחת את פרטי המבקר"

msgid "The assistant asks for a name and a phone or email, saves the lead and emails you."
msgstr "העוזר מבקש שם וטלפון או אימייל, שומר את הליד ושולח לכם אימייל."

msgid "When to offer"
msgstr "מתי להציע"

msgid "One line, for example: when someone wants a quote or a callback."
msgstr "שורה אחת, למשל: כשמישהו רוצה הצעת מחיר או שיחה חוזרת."

msgid "Send leads to"
msgstr "לשלוח לידים אל"

msgid "Keep leads for (days)"
msgstr "לשמור לידים למשך (ימים)"

msgid "Older leads are deleted once a day, along with the conversation they came from."
msgstr "לידים ישנים נמחקים פעם ביום, יחד עם השיחה שממנה הגיעו."

msgid "Note under the chat input"
msgstr "הערה מתחת לשדה הכתיבה בצ׳אט"

msgid "Say that details typed here are passed to the site owner and kept with the conversation."
msgstr "ציינו שפרטים שנכתבים כאן מועברים לבעל האתר ונשמרים יחד עם השיחה."

msgid "Behaviour"
msgstr "התנהגות"

msgid "Products per reply"
msgstr "מוצרים בכל תשובה"

msgid "Three or fewer keeps a reply readable on a phone."
msgstr "שלושה או פחות שומרים על תשובה קריאה בנייד."

msgid "Ask one question before recommending"
msgstr "שאלה אחת לפני המלצה"

msgid "On a vague request the agent asks a single clarifying question first. Better matches, one extra exchange."
msgstr "בבקשה כללית הסוכן ישאל קודם שאלת הבהרה אחת. התאמה טובה יותר, במחיר עוד סבב."

msgid "Prices in the reply text"
msgstr "מחירים בטקסט התשובה"

msgid "Card only"
msgstr "רק בכרטיס"

msgid "recommended"
msgstr "מומלץ"

msgid "Allow in text"
msgstr "מותר בטקסט"

msgid "may go stale"
msgstr "עלול להתיישן"

msgid "The card price is rendered from WooCommerce and is always correct. A price written into a sentence can be repeated later after it changed."
msgstr "המחיר בכרטיס נלקח מווקומרס והוא תמיד נכון. מחיר שנכתב בתוך משפט עלול לחזור בהמשך השיחה אחרי שהשתנה."

msgid "Handoff to a person"
msgstr "מעבר לנציג אנושי"

msgid "Offered as a button when the agent cannot help."
msgstr "מוצע ככפתור כשהסוכן לא מצליח לעזור."

msgid "Chip label"
msgstr "טקסט הכפתור"

msgid "Destination"
msgstr "יעד"

msgid "Your contact page, or a wa.me link for WhatsApp."
msgstr "עמוד יצירת הקשר שלכם, או קישור wa.me לוואטסאפ."

msgid "Live chat"
msgstr "צ׳אט חי"

msgid "A visitor who asks for a person waits for you in the Live chats tab. The AI pauses until you answer or the wait runs out."
msgstr "מבקר שמבקש נציג ממתין לכם בלשונית צ׳אטים חיים. ה-AI עוצר עד שתענו או עד שזמן ההמתנה ייגמר."

msgid "Let visitors ask for a person"
msgstr "לאפשר למבקרים לבקש נציג"

msgid "Turning it on also turns conversation logging on: a live chat lives on the conversation record."
msgstr "הפעלה שלו מפעילה גם את תיעוד השיחות: צ׳אט חי נשמר על רשומת השיחה."

msgid "Send requests to"
msgstr "לשלוח בקשות אל"

msgid "One email per request, with a link to the conversation."
msgstr "אימייל אחד לכל בקשה, עם קישור לשיחה."

msgid "Wait for a person (minutes)"
msgstr "המתנה לנציג (דקות)"

msgid "If nobody joins in time, the visitor is offered lead capture and the contact option. The request stays in the list, so you can still answer later."
msgstr "אם אף אחד לא מצטרף בזמן, המבקר מקבל הצעה להשאיר פרטים ואת אפשרות יצירת הקשר. הבקשה נשארת ברשימה, כך שעדיין אפשר לענות מאוחר יותר."

msgid "Waiting text"
msgstr "טקסט המתנה"

msgid "Joined text"
msgstr "טקסט הצטרפות"

msgid "Missed text"
msgstr "טקסט אי-מענה"

msgid "Closed text"
msgstr "טקסט סיום"

msgid "In the joined and closed texts, %s becomes the name of the person who joined."
msgstr "בטקסטים של ההצטרפות והסיום, %s הופך לשם של מי שהצטרף."

msgid "Spending limits"
msgstr "מגבלות הוצאה"

msgid "Every conversation costs you money at OpenAI. These caps are what stands between a bored bot and a large invoice. One reply can use two or three calls."
msgstr "כל שיחה עולה לכם כסף ב-OpenAI. המגבלות האלה הן מה שעומד בין בוט משועמם לחשבונית גדולה. תשובה אחת יכולה לצרוך שתיים-שלוש קריאות."

msgid "Messages per visitor, per 10 minutes"
msgstr "הודעות לכל מבקר, ב-10 דקות"

msgid "Messages per visitor, per day"
msgstr "הודעות לכל מבקר, ביום"

msgid "Stops one person using up the store's budget."
msgstr "מונע ממשתמש אחד לשרוף את התקציב של החנות."

msgid "API calls for the whole store, per day"
msgstr "קריאות API לכל החנות, ביום"

msgid "The hard daily cost bound."
msgstr "תקרת העלות היומית הקשיחה."

msgid "API calls for the whole store, per month"
msgstr "קריאות API לכל החנות, בחודש"

msgid "Requests at the same time"
msgstr "בקשות במקביל"

msgid "Protects your server rather than your wallet."
msgstr "מגן על השרת שלכם, לא על הארנק."

msgid "Which products the agent may recommend"
msgstr "על אילו מוצרים הסוכן רשאי להמליץ"

msgid "Exclude anything you do not want a bot selling unattended. Excluded categories are invisible to the agent: it cannot find them, mention them or link to them."
msgstr "החריגו כל מה שאתם לא רוצים שבוט ימכור בלי השגחה. קטגוריות שהוחרגו אינן נראות לסוכן: הוא לא ימצא אותן, לא יזכיר אותן ולא יקשר אליהן."

msgid "Only recommend products in stock"
msgstr "המלצה רק על מוצרים במלאי"

msgid "Off means the agent may show out-of-stock products, marked as such on the card."
msgstr "כשכבוי, הסוכן עשוי להציג מוצרים שאזלו, עם סימון בכרטיס."

msgid "Excluded categories"
msgstr "קטגוריות מוחרגות"

msgid "This store has no product categories yet."
msgstr "אין עדיין קטגוריות מוצרים בחנות."

msgid "Child categories are excluded along with their parent."
msgstr "קטגוריות משנה מוחרגות יחד עם קטגוריית האב."

msgid "How the agent searches"
msgstr "איך הסוכן מחפש"

msgid "It searches your live catalogue on every question: product titles, descriptions and SKUs. There is no index to build and nothing to keep in sync, so a product you publish is findable immediately, and one you unpublish disappears the same second."
msgstr "הוא מחפש בקטלוג החי שלכם בכל שאלה: שמות מוצרים, תיאורים ומק\"טים. אין אינדקס לבנות ואין מה לסנכרן, כך שמוצר שתפרסמו יימצא מיד, ומוצר שתורידו ייעלם באותו רגע."

msgid "Live chat is off. With it on, a visitor who asks for a person waits here for you to answer, and the AI pauses until you do."
msgstr "צ׳אט חי כבוי. כשהוא פעיל, מבקר שמבקש נציג ממתין כאן שתענו, וה-AI עוצר עד שתעשו זאת."

msgid "Turn it on in the Agent tab"
msgstr "הפעילו אותו בלשונית הסוכן"

msgid "Pick a conversation from the list."
msgstr "בחרו שיחה מהרשימה."

msgid "Leads are kept %s days, then deleted along with the conversation they came from."
msgstr "לידים נשמרים %s ימים ואז נמחקים יחד עם השיחה שממנה הגיעו."

msgid "Search leads"
msgstr "חיפוש לידים"

msgid "Search"
msgstr "חיפוש"

msgid "Export CSV"
msgstr "ייצוא CSV"

msgid "No leads yet. Turn on lead capture on the Agent tab."
