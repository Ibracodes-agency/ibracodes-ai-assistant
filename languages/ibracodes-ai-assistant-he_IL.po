msgstr "כתבו משהו קודם."

msgid "Add a key first."
msgstr "הוסיפו קודם מפתח."

msgid "Connected. The key works and the model is available."
msgstr "מחובר. המפתח עובד והמודל זמין."

msgid "(price is on the card below)"
msgstr "(המחיר בכרטיס למטה)"

msgid "Ask us anything"
msgstr "שאלו אותנו הכל"

msgid "Have a question?"
msgstr "יש לכם שאלה?"

msgid "Ask me anything"
msgstr "אפשר לשאול אותי הכל"

