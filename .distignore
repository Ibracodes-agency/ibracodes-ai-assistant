# Everything here is development-only and must never reach the plugin zip.
# Patterns are unanchored so both wp dist-archive and the deploy action's rsync read them alike.
.git
.github
.wordpress-org
bin
docs
tests
node_modules
.gitignore
.distignore
.DS_Store
README.md
# translations come from translate.wordpress.org as language packs, so nothing
# in here ships; the folder stays in the repo as the source to import there
languages
